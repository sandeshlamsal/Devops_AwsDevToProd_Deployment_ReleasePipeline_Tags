<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Release Dashboard — ${ENV_NAME}</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="card">

    <span class="env-badge env-${ENV_NAME}">${ENV_NAME}</span>
    <h1>Release Dashboard</h1>
    <p class="subtitle">Active deployment information for this environment</p>

    <div class="version-box">
      <div>
        <div class="version-label">Active Version</div>
        <div class="version-value">${APP_VERSION}</div>
      </div>
      <div class="version-box-right">
        <div class="version-label">Build SHA</div>
        <div class="mono">${BUILD_SHA}</div>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th>Environment</th>
          <th>Status</th>
          <th>Version Tag</th>
          <th>Build Date</th>
        </tr>
      </thead>
      <tbody>
        <tr class="active-row">
          <td><strong>${ENV_NAME}</strong></td>
          <td><span class="dot dot-active"></span>Active</td>
          <td class="mono">${APP_VERSION}</td>
          <td>${BUILD_DATE}</td>
        </tr>
      </tbody>
    </table>

    <p class="footer">
      Built on <strong>${BUILD_DATE}</strong> &nbsp;|&nbsp;
      SHA <span class="mono">${BUILD_SHA}</span> &nbsp;|&nbsp;
      <a href="/version" class="footer-link">version.json</a>
    </p>
  </div>
</body>
</html>
